# =========================================================
# 数据库（二选一）
# =========================================================
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/interview_review
# 或用一组变量：
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=devpass
# PGDATABASE=interview_review

# =========================================================
# 语音识别（ASR）——Whisper 兼容协议
# 默认走 OpenAI 官方；也可换成 Groq / 自托管 whisper.cpp / faster-whisper-server
# =========================================================
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=sk-xxxx
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
# 上传单文件大小上限（MB）；OpenAI/Groq 官方接口硬上限 25MB
MAX_AUDIO_MB=25

# =========================================================
# 分析用大模型（Chat Completions）
# 任意 OpenAI 兼容接口：OpenAI / DeepSeek / GLM / Kimi / Qwen …
# =========================================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o

# =========================================================
# 用户识别（个人自用）
# 多人自部署可改用请求头 X-User-Email 区分数据归属
# =========================================================
AUTH_EMAIL=me@localhost
